# Local development
NODE_ENV=development
PORT=10000
HOST=0.0.0.0

# Required to enable durable order intake.
# Use a managed PostgreSQL database URL (for Render, prefer the internal URL).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set true only when your database provider requires TLS.
DATABASE_SSL=false

# Optional: OpenAI-compatible provider for the creator studio.
# Set secrets only in the hosting provider's protected environment settings.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional: protects the private operator desk.
SURAYA_OPERATOR_TOKEN=
