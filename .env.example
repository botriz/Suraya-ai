# Local development
NODE_ENV=development
PORT=10000
HOST=0.0.0.0

# Required to enable durable order intake.
# Use a managed PostgreSQL database URL (for Render, prefer the internal URL).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set true only when your database provider requires TLS.
DATABASE_SSL=false

# Optional: OpenAI-compatible provider for the creator studio.
# Set secrets only in the hosting provider's protected environment settings.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional: protects the private operator desk.
SURAYA_OPERATOR_TOKEN=

# Autonomous development agent (disabled unless explicitly enabled).
# Create a fine-grained GitHub token restricted to botriz/Suraya-ai with
# Contents: Read and write, Pull requests: Read and write, Checks: Read.
# Store the real token only in Render's protected environment settings.
SURAYA_AGENT_ENABLED=false
SURAYA_AGENT_REPOSITORY=botriz/Suraya-ai
SURAYA_AGENT_BASE_BRANCH=feat/botriz-autonomous-creator-studio
SURAYA_AGENT_GITHUB_TOKEN=
