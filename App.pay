```python
from flask import Flask, request, jsonify
import random

app = Flask(__name__)

# Mock database for tasks
tasks = []

# Endpoint to create a new task
@app.route('/tasks', methods=['POST'])
def create_task():
    task_data = request.json
    tasks.append(task_data)
    return jsonify(task_data), 201

# Endpoint to list all tasks
@app.route('/tasks', methods=['GET'])
def list_tasks():
    return jsonify(tasks), 200

# Endpoint to simulate learning from the internet
@app.route('/learn', methods=['POST'])
def learn():
    new_info = request.json.get('info', '')
    # Here you can implement logic to utilize the new info
    return jsonify({"message": "Learning process initiated.", "info": new_info}), 200

# Endpoint to generate content (mock example)
@app.route('/generate_content', methods=['POST'])
def generate_content():
    topic = request.json.get('topic', 'default')
    content = f"This is a generated content about {topic}."
    return jsonify({"content": content}), 200

if __name__ == '__main__':
    app.run(debug=True, host='0.0.0.0', port=5000)
